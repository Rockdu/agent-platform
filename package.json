{
  "name": "agent-platform-frontend",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "predev": "cargo run --quiet -p plugin-codegen && npm run build:sidecars:debug",
    "build": "tsc -b && vite build",
    "prebuild": "cargo run --quiet -p plugin-codegen && npm run build:sidecars:release",
    "build:sidecars": "npm run build:sidecars:debug",
    "build:sidecars:debug": "cargo build --quiet -p terminal-mesh-sidecar -p notes-plugin -p papers-plugin",
    "build:sidecars:release": "cargo build --release --quiet -p terminal-mesh-sidecar -p notes-plugin -p papers-plugin && node scripts/stage-release-sidecars.mjs",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-notification": "^2",
    "@tauri-apps/plugin-positioner": "^2",
    "@xterm/addon-fit": "^0.10",
    "@xterm/xterm": "^5",
    "react": "^18.3",
    "react-dom": "^18.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/node": "^25.8.0",
    "@types/react": "^18.3",
    "@types/react-dom": "^18.3",
    "@vitejs/plugin-react": "^4",
    "tsx": "^4",
    "typescript": "^5.6",
    "vite": "^5"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "esbuild@0.28.0": true,
    "fsevents@2.3.3": true
  }
}
